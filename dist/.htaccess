# Für Apache (STRATO-Webhosting): Fehlerseite, HTTPS, Caching, Sicherheit
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.handwerker-blesius\.de$ [NC]
  RewriteRule ^ https://handwerker-blesius.de%{REQUEST_URI} [L,R=301]
  # Alte URLs der bisherigen Website weiterleiten
  RewriteRule ^uber-uns/?$ /ueber-uns/ [L,R=301]
  RewriteRule ^referenzen/?$ /projekte/ [L,R=301]
  RewriteRule ^jetzt-bewerben/?$ /karriere/ [L,R=301]
  RewriteRule ^datenschutzerklarung/?$ /datenschutz/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(woff2|webp|jpg|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Zugangsdaten-Datei nie ausliefern
<Files "anfrage-config.php">
  Require all denied
</Files>
